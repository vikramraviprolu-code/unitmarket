# NAMES ONLY. No values. Copy to .env.local (ignored by git) and fill in locally.
# Never paste a value into chat, a PR, a log or a document.
# Only packages/config reads these (architecture.md section 6). Boot refuses unsafe values.

# Mode: offline (default) or sandbox. "live" does not exist and refuses to boot.
UMS_MODE=
# A value already exported in the terminal beats .env.local; boot refuses a differing one (UMS_MODE, UMS_PAYPAL_CONNECT, UMS_DB, UMS_PGLITE_DIR, DATABASE_URL, UMS_OUTBOUND_*, UMS_OWN_MERCHANT_ID, UMS_PUBLIC_ORIGIN). Run env -u NAME.
# off (default) or on. Off forces the dry-run transport.
UMS_PAYPAL_CONNECT=
# Decision-log reference of the owner's written outbound approval (two-key design).
UMS_OUTBOUND_APPROVAL_REF=
# Which approval scope the app serves: mvp_b_polling (default) or mvp_c_refunds. The approval row for
# the reference above must be for this scope; moving to mvp_c_refunds needs a new reference.
UMS_OUTBOUND_SCOPE=
# Our own sandbox merchant id (13 characters, A-Z and 0-9). Not a secret, but never committed.
# When an order's payee equals it exactly, create_order is sent without a payee (D-028).
UMS_OWN_MERCHANT_ID=

# PayPal sandbox app credentials. Server-side only. Owner-run sessions only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Database: pglite-memory, pglite-disk or postgres.
UMS_DB=
UMS_PGLITE_DIR=
DATABASE_URL=

# Server secrets, each at least 32 bytes, all distinct.
UMS_SESSION_SECRET=
UMS_APPROVAL_SECRET=
UMS_LINK_SECRET=
UMS_DEMO_PASSCODE_HASH=
# Operator second factor (TOTP, RFC 6238): name:base32 pairs, comma separated, one key per operator, each
# at least 20 bytes. Make a key at your own terminal with scripts/totp-enrol.mjs. Unset: operators sign in
# without a second factor and cannot refund or turn a switch on.
UMS_OPERATOR_TOTP_KEYS=
# Webhook certificate learn window (D-038). Sandbox mode only, off when unset. A UTC time such as
# 2026-10-25T18:30:00Z, at most 24 hours after the app starts. While it is open the webhook route answers
# 503 to every delivery, acts on nothing and records only the certificate's host, path, subject, issuer,
# dates and fingerprint. Set it in the host settings for the owner's learn step and remove it afterwards.
UMS_WEBHOOK_CERT_LEARN_UNTIL=

# Publisher sign-in hash (CFG-0), same scrypt format as the demo hash and never equal to it. Unset: no
# publisher can sign in.
UMS_PUBLISHER_PASSCODE_HASH=
# Judge sign-in hash (JUDGE-A), same scrypt format as the demo hash and never equal to it or to the
# publisher hash. It signs in the buyer personas only, never the operator or a publisher. Unset: none.
UMS_JUDGE_PASSCODE_HASH=
# Largest offer price in minor units, an integer 1 to 2000 (default 2000, tied to the approval cap).
UMS_OFFER_MAX_MINOR=
# Model adapter for the AI features: scripted (default, offline) or claude. Anything else refuses boot.
UMS_AI_ADAPTER=
# Model API key. Read only when UMS_AI_ADAPTER=claude, and then required. Named UMS_ANTHROPIC_API_KEY on
# purpose: the app never reads the bare ANTHROPIC_API_KEY.
UMS_ANTHROPIC_API_KEY=

UMS_PUBLIC_ORIGIN=
UMS_CORRIDORS=
# Reverse proxies in front of the app, an integer 0 to 3 (default 0). A hosted demo MUST set it:
# with 0 every client shares one login limiter bucket. Counts proxies; X-Forwarded-For is read
# from the right.
UMS_TRUSTED_PROXIES=
# Hosted maintenance mode (D-037): the path of the flag file, named ums-maintenance, beside the PGlite folder.
# Created and removed by the owner in the host shell only; while it exists at boot the app opens no database.
UMS_MAINTENANCE_FLAG=

# The only public variable: a non-secret label such as "Sandbox" or "Dry-run".
NEXT_PUBLIC_UMS_ENV_LABEL=

# NAMES ONLY. No values. Copy to .env.local (ignored by git) and fill in locally.
# Never paste a value into chat, a PR, a log or a document.
# Only packages/config reads these (architecture.md section 6). Boot refuses unsafe values.

# Mode: offline (default) or sandbox. "live" does not exist and refuses to boot.
UMS_MODE=
# off (default) or on. Off forces the dry-run transport.
UMS_PAYPAL_CONNECT=
# Decision-log reference of the owner's written outbound approval (two-key design).
UMS_OUTBOUND_APPROVAL_REF=
# Which approval scope the app serves: mvp_b_polling (default) or mvp_c_refunds. The approval row for
# the reference above must be for this scope; moving to mvp_c_refunds needs a new reference.
UMS_OUTBOUND_SCOPE=
# Our own sandbox merchant id (13 characters, A-Z and 0-9). Not a secret, but never committed.
# When an order's payee equals it exactly, create_order is sent without a payee (D-028).
UMS_OWN_MERCHANT_ID=

# PayPal sandbox app credentials. Server-side only. Owner-run sessions only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Database: pglite-memory, pglite-disk or postgres.
UMS_DB=
UMS_PGLITE_DIR=
DATABASE_URL=

# Server secrets, each at least 32 bytes, all distinct.
UMS_SESSION_SECRET=
UMS_APPROVAL_SECRET=
UMS_LINK_SECRET=
UMS_DEMO_PASSCODE_HASH=
# Operator second factor (TOTP, RFC 6238): name:base32 pairs, comma separated, one key per operator, each
# at least 20 bytes. Make a key at your own terminal with scripts/totp-enrol.mjs. Unset: operators sign in
# without a second factor and cannot refund or turn a switch on.
UMS_OPERATOR_TOTP_KEYS=

UMS_PUBLIC_ORIGIN=
UMS_CORRIDORS=
# Reverse proxies in front of the app, an integer 0 to 3 (default 0). A hosted demo MUST set it:
# with 0 every client shares one login limiter bucket. Counts proxies; X-Forwarded-For is read
# from the right.
UMS_TRUSTED_PROXIES=

# The only public variable: a non-secret label such as "Sandbox" or "Dry-run".
NEXT_PUBLIC_UMS_ENV_LABEL=

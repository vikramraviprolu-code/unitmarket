# Render blueprint for the hosted PayPal sandbox demo (CO-7). NAMES AND SAFE VALUES ONLY.
# Every secret or owner-chosen variable is `sync: false` with no value: the owner enters it in the
# Render dashboard. `pnpm check:hosting` fails on any unsafe setting in this file.
# One process, one instance, one persistent disk (architecture 8). Do not raise numInstances: two
# processes must never share one PGlite directory. Deploys are manual (reviewed tag only, RLR-1).
services:
  - type: web
    name: unitmarket-sandbox
    runtime: node
    plan: starter
    numInstances: 1
    autoDeploy: false
    buildCommand: corepack pnpm install --frozen-lockfile && corepack pnpm --filter @umsbx/web build
    startCommand: corepack pnpm --filter @umsbx/web start
    healthCheckPath: /healthz
    disk:
      name: pglite-data
      mountPath: /var/data
      sizeGB: 1

{
  "name": "unitmarket-sandbox",
  "version": "0.0.0",
  "private": true,
  "description": "UnitMarket PayPal sandbox track (SBX). Offline by default. Not connected to any PayPal account.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "22.22.0",
    "pnpm": "10.34.7"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "corepack pnpm -r --if-present typecheck && tsc -p scripts/tsconfig.json",
    "test": "vitest run --maxWorkers=2 --project unit --project state --project contract --project integration --project adversarial --project golden --passWithNoTests",
    "test:unit": "vitest run --maxWorkers=2 --project unit --passWithNoTests",
    "test:state": "vitest run --maxWorkers=2 --project state --passWithNoTests",
    "test:contract": "vitest run --maxWorkers=2 --project contract --passWithNoTests",
    "test:integration": "vitest run --maxWorkers=2 --project integration --passWithNoTests",
    "test:adversarial": "vitest run --maxWorkers=2 --project adversarial --passWithNoTests",
    "test:golden": "vitest run --maxWorkers=2 --project golden --passWithNoTests",
    "test:e2e": "corepack pnpm --filter @umsbx/web test:e2e",
    "check:isolation": "node scripts/check-isolation.mjs",
    "check:no-live-host": "node scripts/check-no-live-host.mjs",
    "check:secrets-names": "node scripts/check-secrets-names.mjs",
    "cloud:doctor": "bash infra/gcp/cloud.sh doctor",
    "cloud:status": "bash infra/gcp/cloud.sh status",
    "cloud:up": "bash infra/gcp/cloud.sh up",
    "cloud:down": "bash infra/gcp/cloud.sh down",
    "cloud:restart": "bash infra/gcp/cloud.sh restart",
    "cloud:deploy": "bash infra/gcp/cloud.sh deploy",
    "cloud:logs": "bash infra/gcp/cloud.sh logs",
    "check:hosting": "node scripts/check-hosting.mjs",
    "check:hosting-gcp": "node scripts/check-hosting-gcp.mjs",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "record:fixtures": "node --import ./scripts/lib/ts-register.mjs scripts/record-fixtures.mjs",
    "check:routes": "node scripts/route-inventory.mjs --check",
    "check:openapi": "node --import ./scripts/lib/ts-register.mjs scripts/openapi-emit.mjs --check",
    "openapi:emit": "node --import ./scripts/lib/ts-register.mjs scripts/openapi-emit.mjs",
    "check:provenance": "node scripts/check-provenance.mjs",
    "check:licences": "node scripts/licenses-report.mjs --check",
    "check:bundle": "node scripts/check-bundle-secrets.mjs",
    "mutation": "node scripts/mutation-checks.mjs",
    "evidence": "node scripts/evidence.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "corepack pnpm install --frozen-lockfile && corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm check:isolation && corepack pnpm check:no-live-host && corepack pnpm check:secrets-names && corepack pnpm check:hosting && corepack pnpm check:hosting-gcp && corepack pnpm check:fixtures && corepack pnpm check:routes && corepack pnpm check:openapi && corepack pnpm check:provenance && corepack pnpm check:licences",
    "trace:verify": "node --env-file-if-exists=.env.local scripts/trace-verify.mjs",
    "safety:status": "node --env-file-if-exists=.env.local scripts/safety-cli.mjs status",
    "safety:stop": "node --env-file-if-exists=.env.local scripts/safety-cli.mjs stop",
    "safety:approve": "node --env-file-if-exists=.env.local scripts/safety-cli.mjs approve",
    "accounts:reset-password": "node --env-file-if-exists=.env.local scripts/accounts-cli.mjs",
    "privacy:export": "node --env-file-if-exists=.env.local scripts/privacy.mjs export",
    "privacy:delete": "node --env-file-if-exists=.env.local scripts/privacy.mjs delete",
    "safety:resume": "node --env-file-if-exists=.env.local scripts/safety-cli.mjs resume",
    "owner:secrets": "node scripts/owner-secrets.mjs",
    "totp:enrol": "node scripts/totp-enrol.mjs",
    "sandbox:conformance": "node --env-file-if-exists=.env.local scripts/sandbox-conformance.mjs",
    "perf:offline": "node --conditions=react-server --import ./scripts/lib/ts-register.mjs scripts/perf-offline.mjs",
    "log-scan:self-test": "node scripts/log-scan.mjs --self-test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  }
}

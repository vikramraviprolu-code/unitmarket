                    "id",
                    "key_kind",
                    "owner_kind",
                    "scopes",
                    "created_at",
                    "revoked_at",
                    "last_used_at",
                    "token"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "A required header is missing or malformed (for example Idempotency-Key).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No valid credentials.",

              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "key_kind": {
                    "type": "string",
                    "enum": [
                      "api_client",
                      "agent"
                    ]
                  },
                  "scopes": {
                    "minItems": 1,
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "catalogue:read",
                        "orders:read",
                        "orders:write",
                        "library:read",
                        "mandates:write",
                        "events:read",
                        "agent:buy",
                        "offers:write",
                        "sales:read",
                        "ops:read"
                      ]
                    }
                  }
                },
                "required": [
                  "key_kind",
                  "scopes"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      },

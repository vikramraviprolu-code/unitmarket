  "components": {
    "securitySchemes": {
      "bearerKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "umk_<id>_<secret>",
        "description": "An API key issued with POST /api/v1/api-keys. Sent as Authorization: Bearer."
      },
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-ums_s",
        "description": "The signed-in session of a buyer, publisher or operator."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
